# Copy to .env.local; never commit real values.
# DATABASE_URL from Vercel Postgres (Neon)
DATABASE_URL=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Agent-run budget guardrails (ADR 0002): per-IP/day, global/day
RAILOPS_BUDGET_PER_IP_DAILY=20
RAILOPS_BUDGET_GLOBAL_DAILY=500

# Per-agent model pins (ADR 0005); defaults live in baml_src/clients.baml
RAILOPS_INTAKE_MODEL=openai/gpt-oss-20b
RAILOPS_OFFICER_MODEL=z-ai/glm-5.2:free
RAILOPS_CRITIC_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
RAILOPS_EVAL_JUDGE_MODEL=openai/gpt-oss-120b

# Hindsight local memory adapter. Leave HINDSIGHT_API_URL unset for offline mode;
# the adapter degrades to empty reviewer context and tombstones locally.
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=

