# Copy to .env.local; never commit real values.

# Required: Groq API key used by the BAML client (server-side only).
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Hindsight local memory server. Leave HINDSIGHT_API_URL unset for
# offline mode; the adapter degrades to empty reviewer context and local
# tombstones. The setup wizard starts a local server on port 8888.
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=

# Optional: PLK (pdp-api.plk-sa.pl) live route/disruption adapter.
# Leave PLK_API_KEY unset to use deterministic cassettes under cassettes/plk/.
# Auth header: X-API-Key. Recording script: scripts/record-plk-cassette.ts
PLK_API_KEY=

# Test-only switches. Never set these in a real environment.
# RAILOPS_FAKE_LLM=1 forces the stub LLM in API tests.
# RAILOPS_LIVE_SMOKE=1 opts in to the live Groq smoke test (test/evals.test.ts).
