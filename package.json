{
  "name": "railops-baml-demo",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "esbuild": true,
    "@scarf/scarf": false
  },
  "scripts": {
    "prebuild": "npm run baml:generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.test.json --test \"test/**/*.test.{ts,tsx}\"",
    "test:memory": "tsx --tsconfig tsconfig.test.json --test test/memory.test.ts",
    "test:page": "tsx --tsconfig tsconfig.test.json --test test/page-cases.test.tsx",
    "memory:init": "tsx scripts/init-memory.ts",
    "baml:generate": "baml-cli generate",
    "knowledge:index": "tsx scripts/build-knowledge-index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@boundaryml/baml": "0.203.1",
    "@daypicker/react": "^10.0.1",
    "@vectorize-io/hindsight-client": "^0.9.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "^15.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "shadow-plugin": "^2.1.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
